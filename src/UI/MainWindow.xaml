<!--
    Main dashboard layout, styles and data bindings.
    Controller.ps1 resolves named controls, wires events and supplies localized
    DynamicResource values and row objects. Network work belongs to worker runspaces.
-->
<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource MainWindow.Title}" Width="1240" Height="820"
        MinWidth="960" MinHeight="640" WindowStartupLocation="CenterScreen"
        Background="#F3F5F8" FontFamily="Segoe UI" FontSize="13">
    <Window.Resources>
        <!-- Vector icons stay sharp at Windows display scaling levels without extra fonts or files. -->
        <DrawingImage x:Key="RefreshIcon">
            <DrawingImage.Drawing>
                <GeometryDrawing Brush="#439B45" Geometry="M 20,9 A 8,8 0 0 0 6,5 L 3,2 L 3,10 L 11,10 L 8,7 A 5,5 0 0 1 17,9 Z M 4,15 A 8,8 0 0 0 18,19 L 21,22 L 21,14 L 13,14 L 16,17 A 5,5 0 0 1 7,15 Z"/>
            </DrawingImage.Drawing>
        </DrawingImage>
        <DrawingImage x:Key="ExportIcon">
            <DrawingImage.Drawing>
                <DrawingGroup>
                    <GeometryDrawing Brush="#EAF3FC" Geometry="M 3,1 L 14,1 L 19,6 L 19,22 L 3,22 Z">
                        <GeometryDrawing.Pen><Pen Brush="#447DA8" Thickness="1"/></GeometryDrawing.Pen>
                    </GeometryDrawing>
                    <GeometryDrawing Brush="#8AB7DC" Geometry="M 14,1 L 14,6 L 19,6 Z M 6,7 L 11,7 L 11,9 L 6,9 Z M 6,11 L 14,11 L 14,13 L 6,13 Z"/>
                    <GeometryDrawing Brush="#439B45" Geometry="M 12,15 L 18,15 L 18,11 L 24,17 L 18,23 L 18,19 L 12,19 Z"/>
                </DrawingGroup>
            </DrawingImage.Drawing>
        </DrawingImage>
        <DrawingImage x:Key="FolderIcon">
            <DrawingImage.Drawing>
                <DrawingGroup>
                    <GeometryDrawing Brush="#FFE09A" Geometry="M 1,5 L 1,2 L 9,2 L 12,5 L 23,5 L 23,21 L 1,21 Z">
                        <GeometryDrawing.Pen><Pen Brush="#B98222" Thickness="1"/></GeometryDrawing.Pen>
                    </GeometryDrawing>
                    <GeometryDrawing Brush="#F5BE48" Geometry="M 1,8 L 23,8 L 23,21 L 1,21 Z">
                        <GeometryDrawing.Pen><Pen Brush="#B98222" Thickness="1"/></GeometryDrawing.Pen>
                    </GeometryDrawing>
                </DrawingGroup>
            </DrawingImage.Drawing>
        </DrawingImage>
        <DrawingImage x:Key="OpenIcon">
            <DrawingImage.Drawing>
                <DrawingGroup>
                    <GeometryDrawing Brush="#EAF3FC" Geometry="M 5,1 L 16,1 L 21,6 L 21,23 L 5,23 Z">
                        <GeometryDrawing.Pen><Pen Brush="#447DA8" Thickness="1"/></GeometryDrawing.Pen>
                    </GeometryDrawing>
                    <GeometryDrawing Brush="#8AB7DC" Geometry="M 16,1 L 16,6 L 21,6 Z M 9,17 L 17,17 L 17,19 L 9,19 Z"/>
                    <GeometryDrawing Brush="#327FC1" Geometry="M 0,9 L 9,9 L 9,5 L 16,12 L 9,19 L 9,15 L 0,15 Z"/>
                </DrawingGroup>
            </DrawingImage.Drawing>
        </DrawingImage>
        <Style x:Key="ToolbarIconStyle" TargetType="Image">
            <Setter Property="Width" Value="20"/>
            <Setter Property="Height" Value="20"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Style.Triggers>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Opacity" Value="0.4"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="14,7"/>
            <Setter Property="Margin" Value="3"/>
        </Style>
        <Style TargetType="DataGrid">
            <Setter Property="AutoGenerateColumns" Value="False"/>
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="CanUserAddRows" Value="False"/>
            <Setter Property="CanUserDeleteRows" Value="False"/>
            <Setter Property="HeadersVisibility" Value="Column"/>
            <Setter Property="GridLinesVisibility" Value="Horizontal"/>
            <Setter Property="HorizontalGridLinesBrush" Value="#E8ECF1"/>
            <Setter Property="RowHeight" Value="36"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#CFD6DF"/>
            <Setter Property="SelectionMode" Value="Single"/>
        </Style>
    </Window.Resources>
    <DockPanel>
        <Menu DockPanel.Dock="Top" Background="#FAFBFC" Padding="8,4">
            <MenuItem Header="{DynamicResource Menu.File}">
                <MenuItem x:Name="OpenMenuItem" Header="{DynamicResource Action.Open}"/>
                <MenuItem x:Name="ExportMenuItem" Header="{DynamicResource Action.Export}"/>
                <Separator/>
                <MenuItem x:Name="ExitMenuItem" Header="{DynamicResource Action.Exit}"/>
            </MenuItem>
            <MenuItem Header="{DynamicResource Menu.View}">
                <MenuItem x:Name="PauseMenuItem" IsCheckable="True" Header="{DynamicResource Action.Pause}"/>
                <MenuItem x:Name="RefreshMenuItem" Header="{DynamicResource Action.Refresh}"/>
            </MenuItem>
            <MenuItem Header="{DynamicResource Menu.Tools}">
                <MenuItem x:Name="ReloadMenuItem" Header="{DynamicResource Action.Reload}"/>
                <MenuItem x:Name="LogsMenuItem" Header="{DynamicResource Action.Logs}"/>
            </MenuItem>
            <MenuItem Header="{DynamicResource Menu.Help}">
                <MenuItem x:Name="AboutMenuItem" Header="{DynamicResource Action.About}"/>
            </MenuItem>
        </Menu>
        <Border DockPanel.Dock="Top" BorderBrush="#CFD6DF" BorderThickness="0,0,0,1" Padding="8">
            <StackPanel Orientation="Horizontal">
                <Button x:Name="RefreshButton" AutomationProperties.Name="{DynamicResource Action.Refresh}">
                    <StackPanel Orientation="Horizontal">
                        <Image Source="{StaticResource RefreshIcon}" Style="{StaticResource ToolbarIconStyle}"/>
                        <TextBlock Text="{DynamicResource Action.Refresh}" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <Button x:Name="ExportButton" AutomationProperties.Name="{DynamicResource Action.Export}">
                    <StackPanel Orientation="Horizontal">
                        <Image Source="{StaticResource ExportIcon}" Style="{StaticResource ToolbarIconStyle}"/>
                        <TextBlock Text="{DynamicResource Action.Export}" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <Button x:Name="FolderButton" AutomationProperties.Name="{DynamicResource Action.Folder}">
                    <StackPanel Orientation="Horizontal">
                        <Image Source="{StaticResource FolderIcon}" Style="{StaticResource ToolbarIconStyle}"/>
                        <TextBlock Text="{DynamicResource Action.Folder}" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <Button x:Name="OpenButton" AutomationProperties.Name="{DynamicResource Action.Open}">
                    <StackPanel Orientation="Horizontal">
                        <Image Source="{StaticResource OpenIcon}" Style="{StaticResource ToolbarIconStyle}"/>
                        <TextBlock Text="{DynamicResource Action.Open}" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </StackPanel>
        </Border>
        <StatusBar DockPanel.Dock="Bottom" Padding="10,6" Background="#E8EDF3">
            <TextBlock x:Name="SummaryTextBlock"/>
            <Separator/>
            <TextBlock x:Name="ActivityTextBlock"/>
        </StatusBar>
        <Grid Margin="8">
            <Grid.ColumnDefinitions><ColumnDefinition Width="185"/><ColumnDefinition Width="8"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <Border Background="White" BorderBrush="#CFD6DF" BorderThickness="1" Padding="8">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="{DynamicResource Label.Groups}" FontWeight="SemiBold" Margin="4,4,4,12"/>
                    <ListBox x:Name="GroupsListBox" BorderThickness="0" DisplayMemberPath="Label" SelectedValuePath="Value"/>
                </DockPanel>
            </Border>
            <Grid Grid.Column="2">
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="8"/><RowDefinition Height="250"/></Grid.RowDefinitions>
                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="160"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <Label Content="{DynamicResource Label.Search}" Target="{Binding ElementName=SearchTextBox}" VerticalAlignment="Center"/>
                    <TextBox x:Name="SearchTextBox" Grid.Column="1" Padding="8" VerticalContentAlignment="Center" AutomationProperties.Name="{DynamicResource Label.Search}"/>
                    <Label Grid.Column="2" Content="{DynamicResource Label.Group}" Target="{Binding ElementName=GroupComboBox}" Margin="8,0,0,0" VerticalAlignment="Center"/>
                    <ComboBox x:Name="GroupComboBox" Grid.Column="3" DisplayMemberPath="Label" SelectedValuePath="Value" VerticalContentAlignment="Center"/>
                    <CheckBox x:Name="ErrorsOnlyCheckBox" Grid.Column="4" Content="{DynamicResource Label.ErrorsOnly}" VerticalAlignment="Center" Margin="12,0,0,0"/>
                </Grid>
                <DataGrid x:Name="ChecksDataGrid" Grid.Row="1" EnableRowVirtualization="True">
                    <DataGrid.Columns>
                        <DataGridTemplateColumn Header="{DynamicResource Column.Name}" Width="180">
                            <DataGridTemplateColumn.CellTemplate><DataTemplate>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="8,0">
                                    <Ellipse Width="11" Height="11" Fill="{Binding Color}" Margin="0,0,8,0"/>
                                    <TextBlock Text="{Binding Name}"/>
                                </StackPanel>
                            </DataTemplate></DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="{DynamicResource Column.Type}" Binding="{Binding Type}" Width="65"/>
                        <DataGridTextColumn Header="{DynamicResource Column.Target}" Binding="{Binding Target}" Width="*" MinWidth="120"/>
                        <DataGridTextColumn Header="{DynamicResource Column.Ping}" Binding="{Binding Ping}" Width="75"/>
                        <DataGridTextColumn Header="{DynamicResource Column.Service}" Binding="{Binding Service}" Width="65"/>
                        <DataGridTextColumn Header="{DynamicResource Column.Http}" Binding="{Binding Http}" Width="60"/>
                        <DataGridTextColumn Header="{DynamicResource Column.Checked}" Binding="{Binding Checked}" Width="100"/>
                        <DataGridTextColumn Header="{DynamicResource Column.Status}" Binding="{Binding StatusText}" Width="135"/>
                    </DataGrid.Columns>
                </DataGrid>
                <GridSplitter Grid.Row="2" Height="8" HorizontalAlignment="Stretch"/>
                <DockPanel Grid.Row="3">
                    <TextBlock x:Name="SelectionTextBlock" DockPanel.Dock="Top" FontWeight="SemiBold" FontSize="18" Margin="8,4,8,10"/>
                    <TabControl>
                        <TabItem Header="{DynamicResource Tab.Details}">
                            <ScrollViewer VerticalScrollBarVisibility="Auto"><TextBlock x:Name="DetailsTextBlock" Margin="16" TextWrapping="Wrap" FontSize="14"/></ScrollViewer>
                        </TabItem>
                        <TabItem Header="{DynamicResource Tab.History}">
                            <DataGrid x:Name="HistoryDataGrid">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="{DynamicResource Column.Checked}" Binding="{Binding Checked}" Width="160"/>
                                    <DataGridTextColumn Header="{DynamicResource Column.Status}" Binding="{Binding StatusText}" Width="150"/>
                                    <DataGridTextColumn Header="{DynamicResource Column.Duration}" Binding="{Binding DurationMs}" Width="100"/>
                                    <DataGridTextColumn Header="{DynamicResource Column.Message}" Binding="{Binding MessageText}" Width="*"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </TabItem>
                        <TabItem Header="{DynamicResource Tab.Log}">
                            <TextBox x:Name="JournalTextBox" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" BorderThickness="0" Padding="10"/>
                        </TabItem>
                    </TabControl>
                </DockPanel>
            </Grid>
        </Grid>
    </DockPanel>
</Window>
